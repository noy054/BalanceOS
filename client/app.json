{
  "expo": {
    "name": "BalanceOS",
    "slug": "balanceos",
    "scheme": "balanceos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.balanceos.mobile"
    },
    "android": {
      "package": "com.balanceos.mobile",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.216338591550-om7g46fu9icittfflr36ki7pemah8ovl"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BalanceOS to use your camera to scan barcodes and take product photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BalanceOS to access your photos to add product images.",
          "cameraPermission": "Allow BalanceOS to use your camera to scan barcodes and take product photos.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4e5aa1fd-ddac-40f3-9224-9d8e7474c54e"
      }
    }
  }
}

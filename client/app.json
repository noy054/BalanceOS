{
  "expo": {
    "name": "TrackMode",
    "slug": "balanceos",
    "scheme": "balanceos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.peakmode.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "he",
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.peakmode.app",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#0B140F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "name": "TrackMode",
      "shortName": "TrackMode",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.216338591550-om7g46fu9icittfflr36ki7pemah8ovl"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "TrackMode uses the camera to scan product barcodes and take photos of foods you add.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "TrackMode uses your photos only when you choose an image for a food or a progress entry.",
          "cameraPermission": "TrackMode uses the camera to scan product barcodes and take photos of foods you add.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B140F",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B140F"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4e5aa1fd-ddac-40f3-9224-9d8e7474c54e"
      }
    },
    "locales": {
      "he": "./store/locales/he.json",
      "en": "./store/locales/en.json"
    }
  }
}

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# JWT
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=replace-with-google-client-id

# USDA FoodData Central — barcode fallback when Open Food Facts returns nothing
# Free API key: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=replace-with-usda-api-key

# SMTP — password reset emails
# Resend: get API key at https://resend.com, verify your domain, then set SMTP_FROM to a verified address.
# Leave all SMTP_* vars unset in dev to fall back to console token logging.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=BalanceOS <no-reply@yourdomain.com>

# Server
PORT=3000

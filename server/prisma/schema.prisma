generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  passwordHash String?
  provider     String   @default("local")
  googleId     String?  @unique
  role         UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  nutritionSettings   UserNutritionSettings?
  pantryProducts      PantryProduct[]
  pantryRecipes       PantryRecipe[]
  savedMeals          SavedMeal[]
  dayLogs             DayLog[]

  createdCatalogItems  ProductCatalogItem[]  @relation("ProductCatalogCreatedBy")
  updatedCatalogItems  ProductCatalogItem[]  @relation("ProductCatalogUpdatedBy")
  catalogSubmissions   CatalogSubmission[]   @relation("CatalogSubmissionAuthor")
  reviewedSubmissions  CatalogSubmission[]   @relation("CatalogSubmissionReviewer")
  archivedCatalogItems ProductCatalogItem[]  @relation("ProductCatalogArchivedBy")
  adminAuditLogs       AdminAuditLog[]
  createdAnnouncements Announcement[]        @relation("AnnouncementCreatedBy")
  updatedAnnouncements Announcement[]        @relation("AnnouncementUpdatedBy")
  announcementReceipts AnnouncementReceipt[]
  bodyEntries          BodyEntry[]
  progressPhotos       ProgressPhoto[]

  @@index([email])
}

model UserNutritionSettings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  experienceMode      String  @default("GUIDED")
  targetMode          String  @default("AUTO")
  onboardingCompleted Boolean @default(false)
  preferredLanguage   String  @default("he")

  dailyCaloriesTarget Int?
  proteinTarget       Int?
  carbsTarget         Int?
  fatTarget           Int?
  fiberTarget         Int?

  // Profile
  gender              String?
  birthDate           DateTime?
  heightCm            Float?
  weightKg            Float?
  trainingDaysPerWeek Int?
  goalType            String?

  // Display
  themeMode String @default("LIGHT")

  // Home display preferences
  showFiberOnHome         Boolean @default(true)
  showCarbsOnHome         Boolean @default(true)
  showFatOnHome           Boolean @default(true)
  showProgressPercentages Boolean @default(true)

  // Guided mode features
  showGuidedSuggestions Boolean @default(true)
  showMotivation        Boolean @default(true)

  // Tracking preferences
  defaultFoodUnit FoodUnit @default(GRAMS)

  // Notification preferences
  breakfastReminderEnabled Boolean @default(false)
  breakfastReminderTime    String?
  lunchReminderEnabled     Boolean @default(false)
  lunchReminderTime        String?
  dinnerReminderEnabled    Boolean @default(false)
  dinnerReminderTime       String?
  waterReminderEnabled     Boolean @default(false)
  waterReminderInterval    Int?
  dailySummaryEnabled      Boolean @default(false)
  dailySummaryTime         String?
  weeklySummaryEnabled     Boolean @default(false)
  weeklySummaryDay         Int?
  weeklySummaryTime        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  USER
  ADMIN
}

enum NutritionBasis {
  PER_100G
  PER_SERVING
}

enum CatalogSubmissionKind {
  CORRECTION
  NEW_PRODUCT
}

enum CatalogSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

enum FoodUnit {
  GRAMS
  SERVING
  PIECE
}

model ProductCatalogItem {
  id String @id @default(cuid())

  barcode           String?
  gtin              String?
  normalizedBarcode String? @unique

  name         String
  brand        String?
  manufacturer String?
  category     String?
  subCategory  String?

  countryCode  String? @default("IL")
  languageCode String? @default("he")

  imageUrl        String?
  ingredientsText String?
  allergensText   String?

  servingSizeText  String?
  servingSizeGrams Float?
  servingQuantity  Float?
  servingUnit      String?

  nutritionBasis NutritionBasis @default(PER_100G)

  caloriesPer100g     Float?
  proteinPer100g      Float?
  carbsPer100g        Float?
  sugarPer100g        Float?
  fatPer100g          Float?
  saturatedFatPer100g Float?
  fiberPer100g        Float?
  sodiumPer100g       Float?
  saltPer100g         Float?

  caloriesPerServing Float?
  proteinPerServing  Float?
  carbsPerServing    Float?
  fatPerServing      Float?
  fiberPerServing    Float?

  nutrients    Json?
  originalData Json?

  source             ProductSource             @default(MANUAL)
  verificationStatus ProductVerificationStatus @default(UNVERIFIED)

  externalProvider String?
  externalId       String?
  externalRawData  Json?

  createdByUserId  String?
  updatedByUserId  String?
  archivedAt       DateTime?
  archivedByUserId String?

  createdByUser  User? @relation("ProductCatalogCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser  User? @relation("ProductCatalogUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  archivedByUser User? @relation("ProductCatalogArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pantryProducts PantryProduct[]
  submissions    CatalogSubmission[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductCatalogItem_name_trgm_idx")
  @@index([brand(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductCatalogItem_brand_trgm_idx")
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([archivedAt])
  @@index([archivedByUserId])
}

model BarcodeLookupMiss {
  normalizedBarcode String   @id
  attempts          Int      @default(1)
  lastCheckedAt     DateTime @default(now())
}

enum ProductSource {
  INTERNAL
  OPEN_FOOD_FACTS
  USDA_FDC
  MANUAL
  ADMIN
}

enum ProductCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum ProductVerificationStatus {
  UNVERIFIED
  USER_SUBMITTED
  AUTO_IMPORTED
  ADMIN_VERIFIED
  REJECTED
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PantryProduct {
  id                 String            @id @default(cuid())
  userId             String
  name               String
  brand              String?
  barcode            String?
  normalizedBarcode  String?
  catalogItemId      String?
  imageUrl           String?
  nutritionBasis     NutritionBasis    @default(PER_100G)
  caloriesPer100g    Float?
  proteinPer100g     Float?
  carbsPer100g       Float?
  fatPer100g         Float?
  fiberPer100g       Float?
  caloriesPerServing Float?
  proteinPerServing  Float?
  carbsPerServing    Float?
  fatPerServing      Float?
  fiberPerServing    Float?
  nutrients          Json?
  servingSizeG       Float?
  servingSizeText    String?
  servingQuantity    Float?
  servingUnit        String?
  mealCategories     ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem    ProductCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  recipeItems    PantryRecipeItem[]
  savedMealItems SavedMealItem[]
  mealItems      MealItem[]
  submissions    CatalogSubmission[]

  @@unique([userId, normalizedBarcode])
  @@unique([userId, catalogItemId])
  @@index([userId, name, id])
  @@index([catalogItemId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "PantryProduct_name_trgm_idx")
  @@index([brand(ops: raw("gin_trgm_ops"))], type: Gin, map: "PantryProduct_brand_trgm_idx")
}

model PantryRecipe {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?
  mealType    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          PantryRecipeItem[]
  savedMealItems SavedMealItem[]
  mealItems      MealItem[]

  @@index([userId])
}

model PantryRecipeItem {
  id        String @id @default(cuid())
  recipeId  String
  productId String
  grams     Float?
  servings  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe  PantryRecipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product PantryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model SavedMeal {
  id       String  @id @default(cuid())
  userId   String
  name     String
  mealType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     SavedMealItem[]
  mealItems MealItem[]

  @@index([userId])
}

model SavedMealItem {
  id          String  @id @default(cuid())
  savedMealId String
  productId   String?
  recipeId    String?
  grams       Float?
  servings    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedMeal SavedMeal      @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  product   PantryProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  recipe    PantryRecipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([savedMealId])
}

model DayLog {
  id              String @id @default(cuid())
  userId          String
  date            String
  targetsSnapshot Json
  caloriesTotal   Float  @default(0)
  proteinTotal    Float  @default(0)
  carbsTotal      Float  @default(0)
  fatTotal        Float  @default(0)
  fiberTotal      Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealEntries MealEntry[]

  @@unique([userId, date])
  @@index([userId])
}

model MealEntry {
  id       String @id @default(cuid())
  dayLogId String
  mealType String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dayLog DayLog     @relation(fields: [dayLogId], references: [id], onDelete: Cascade)
  items  MealItem[]

  @@unique([dayLogId, mealType])
  @@index([dayLogId])
}

model MealItem {
  id              String  @id @default(cuid())
  mealEntryId     String
  pantryProductId String?
  pantryRecipeId  String?
  savedMealId     String?
  grams           Float?
  servings        Float?
  macrosSnapshot  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mealEntry     MealEntry      @relation(fields: [mealEntryId], references: [id], onDelete: Cascade)
  pantryProduct PantryProduct? @relation(fields: [pantryProductId], references: [id], onDelete: SetNull)
  pantryRecipe  PantryRecipe?  @relation(fields: [pantryRecipeId], references: [id], onDelete: SetNull)
  savedMeal     SavedMeal?     @relation(fields: [savedMealId], references: [id], onDelete: SetNull)

  @@index([mealEntryId])
}

model CatalogSubmission {
  id                String                  @id @default(cuid())
  kind              CatalogSubmissionKind
  status            CatalogSubmissionStatus @default(PENDING)
  userId            String
  pantryProductId   String?
  catalogItemId     String?
  normalizedBarcode String?
  productName       String                  @default("")
  proposedData      Json
  reviewedByUserId  String?
  reviewNote        String?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                @relation("CatalogSubmissionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy    User?               @relation("CatalogSubmissionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  pantryProduct PantryProduct?      @relation(fields: [pantryProductId], references: [id], onDelete: SetNull)
  catalogItem   ProductCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([status, kind, createdAt])
  @@index([pantryProductId])
  @@index([catalogItemId])
  @@index([userId])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  summary     String?
  details     Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId])
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementKind {
  UPDATE
  NOTICE
  IMPORTANT
}

enum AnnouncementDisplay {
  BANNER
  POPUP
}

enum AnnouncementActionType {
  NONE
  ROUTE
  URL
}

model Announcement {
  id     String             @id @default(cuid())
  status AnnouncementStatus @default(DRAFT)
  kind   AnnouncementKind   @default(NOTICE)

  display AnnouncementDisplay @default(BANNER)

  titleHe String
  titleEn String
  bodyHe  String
  bodyEn  String

  actionType    AnnouncementActionType @default(NONE)
  actionTarget  String?
  actionLabelHe String?
  actionLabelEn String?

  platforms     String[]
  minAppVersion String?
  maxAppVersion String?

  publishAt  DateTime?
  expiresAt  DateTime?
  archivedAt DateTime?

  createdByUserId String?
  updatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("AnnouncementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("AnnouncementUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  receipts AnnouncementReceipt[]

  @@index([status, publishAt, expiresAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model AnnouncementReceipt {
  id             String    @id @default(cuid())
  userId         String
  announcementId String
  seenAt         DateTime  @default(now())
  dismissedAt    DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([announcementId])
}

model BodyEntry {
  id         String  @id @default(cuid())
  userId     String
  date       String
  weightKg   Float?
  waistCm    Float?
  hipsCm     Float?
  chestCm    Float?
  upperArmCm Float?
  thighCm    Float?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos ProgressPhoto[]

  @@index([userId, date])
}

model ProgressPhoto {
  id         String @id @default(cuid())
  entryId    String
  userId     String
  storageKey String @unique
  mimeType   String
  sizeBytes  Int

  createdAt DateTime @default(now())

  entry BodyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([userId])
}
